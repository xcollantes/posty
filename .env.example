# ---- Core (required) ----
# The tailnet URL of the UI: https://<TS_HOSTNAME>.<your-tailnet>.ts.net
APP_URL=https://posty.example-tailnet.ts.net
# Encrypts stored tokens and signs cookies. Generate: openssl rand -base64 48
# Changing it later makes every connected account need reconnecting.
APP_KEY=
# First admin, created on first start when no user exists. Sign-in is by
# passkey: get a link to create yours with the signin-link script (README).
ADMIN_EMAIL=you@example.com
POSTGRES_PASSWORD=
# Timezone for the first admin (changeable in Settings)
TZ=America/Los_Angeles

# ---- Media for Instagram, Threads and Facebook video ----
# Meta fetches media by URL. Posty copies each file to this private bucket
# and hands Meta a 1-hour signed URL. See docs/media-bucket.md.
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcs-key.json
# Without GCS_BUCKET, Meta gets <PUBLIC_MEDIA_URL>/media/<file> instead,
# which must then be publicly reachable. Defaults to APP_URL.
# PUBLIC_MEDIA_URL=

# ---- Tailscale sidecar ----
# Auth key (tskey-auth-...) or OAuth client secret (then also set TS_EXTRA_ARGS)
TS_AUTHKEY=
TS_HOSTNAME=posty
# TS_EXTRA_ARGS=--advertise-tags=tag:posty
# Let Claude Code cloud sessions in over Tailscale Funnel
# (README "From Claude Code cloud sessions"):
# TS_SERVE_CONFIG=/config/serve-funnel.json

# ---- Optional ----
# Slack/Discord-compatible webhook for failed posts
NOTIFY_WEBHOOK_URL=
# Fetch X metrics daily (each read is billed by X)
X_METRICS=0

# ---- LLM access over MCP (see README "Use from Claude") ----
# Bearer token for /api/mcp. Leave blank to turn the endpoint off.
# Generate: openssl rand -base64 32
MCP_TOKEN=

# ---- Networks (see docs/networks.md). Leave blank to hide a network. ----
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CONFIG_ID=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Trial-access Pinterest apps: PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
# Bluesky and Mastodon need no keys.
