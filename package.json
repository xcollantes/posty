{
  "name": "posty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild worker.ts scripts/migrate.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist --tsconfig=tsconfig.json --out-extension:.js=.mjs",
    "start": "next start",
    "worker": "npm run build:worker && node --env-file-if-exists=.env dist/worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run build:worker && node --env-file-if-exists=.env dist/scripts/migrate.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@google-cloud/storage": "^8.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "emoji-picker-element": "^1.29.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "twitter-text": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "^3.1.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
